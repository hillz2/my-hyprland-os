#!/usr/bin/env bash

REPO_URL="https://github.com/hillz2/Dotfiles.git"
TARGET_DIR="$HOME/Dotfiles"
MARKER="$HOME/.dotfiles_bootstrapped"
LOG="/tmp/dotfiles-bootstrap.log"

# 0. Exit immediately if this user account has already been bootstrapped
[[ -f "$MARKER" ]] && exit 0

echo "--- Bootstrap initiated at $(date) ---" > "$LOG"

# Function: Safely hold notify-send until Mako/Dunst registers on the session bus
safe_notify() {
    local title="$1"
    local msg="$2"
    local urgency="${3:-normal}"

    # Poll D-Bus for up to 15 seconds waiting for org.freedesktop.Notifications
    local count=0
    while ! dbus-send --session --dest=org.freedesktop.DBus --type=method_call --print-reply /org/freedesktop/DBus org.freedesktop.DBus.ListNames 2>/dev/null | grep -q "org.freedesktop.Notifications"; do
        sleep 0.5
        count=$((count + 1))
        [[ $count -ge 30 ]] && break
    done

    notify-send "$title" "$msg" -u "$urgency" -a "GalihOS Bootstrap" -i terminal
}

# 1. Clone the repository
if git clone "$REPO_URL" "$TARGET_DIR" >> "$LOG" 2>&1; then
    echo "Git clone successful." >> "$LOG"
else
    safe_notify "OS Bootstrap Critical Error" "Failed to clone Dotfiles repo. Check $LOG" "critical"
    exit 1
fi

# 2. Map the repo to the Home Directory
mkdir -p "$HOME/.config"
IGNORE=("README.md" "auto_backup.sh" ".git" ".github" "LICENSE")

cd "$TARGET_DIR" || exit 1

for item in *; do
    skip=false
    for ignored in "${IGNORE[@]}"; do
        [[ "$item" == "$ignored" ]] && { skip=true; break; }
    done
    [[ "$skip" == true ]] && continue

    if [[ -d "$item" ]]; then
        # It's an XDG folder (hypr, kitty, waybar, rofi)
        # Wipe the empty skeleton placeholder generated by the OS, then link
        rm -rf "$HOME/.config/$item"
        ln -s "$TARGET_DIR/$item" "$HOME/.config/$item"
        echo "Symlinked directory: ~/.config/$item -> Dotfiles/$item" >> "$LOG"

    elif [[ -f "$item" ]]; then
        # It's a root dotfile (zshrc, vimrc, tmux.conf)
        rm -f "$HOME/.$item"
        ln -s "$TARGET_DIR/$item" "$HOME/.$item"
        echo "Symlinked file: ~/.$item -> Dotfiles/$item" >> "$LOG"
    fi
done

# 3. Mark as completed and celebrate
touch "$MARKER"
safe_notify "Welcome to GalihOS" "Dotfiles cloned & symlinked successfully." "normal"
