#!/usr/bin/env bash

REPO_URL="https://github.com/hillz2/Dotfiles.git"
TARGET_DIR="$HOME/Dotfiles"
MARKER="$HOME/.dotfiles_bootstrapped"
LOG="/tmp/dotfiles-bootstrap.log"

[[ -f "$MARKER" ]] && exit 0
echo "--- Bootstrap initiated at $(date) ---" > "$LOG"

safe_notify() {
    local title="$1"
    local msg="$2"
    local urgency="${3:-normal}"

    local count=0
    while ! dbus-send --session --dest=org.freedesktop.DBus --type=method_call --print-reply /org/freedesktop/DBus org.freedesktop.DBus.ListNames 2>/dev/null | grep -q "org.freedesktop.Notifications"; do
        sleep 0.5
        count=$((count + 1))
        [[ $count -ge 30 ]] && break
    done

    notify-send "$title" "$msg" -u "$urgency" -i terminal
}

# 1. Clone the repo
if git clone "$REPO_URL" "$TARGET_DIR" >> "$LOG" 2>&1; then
    echo "Git clone successful." >> "$LOG"
else
    safe_notify "OS Bootstrap Error" "Failed to clone Dotfiles repo. Check $LOG" "critical"
    exit 1
fi

mkdir -p "$HOME/.config"

# 2. ROUTE A: XDG Config Folders (goes to ~/.config/app_name)
XDG_APPS=("hypr" "kitty" "rofi" "systemd" "wallust" "waybar" "xdg-desktop-portal")

for app in "${XDG_APPS[@]}"; do
    if [[ -d "$TARGET_DIR/$app" ]]; then
        rm -rf "$HOME/.config/$app"
        ln -s "$TARGET_DIR/$app" "$HOME/.config/$app"
        echo "Routed XDG: ~/.config/$app -> Dotfiles/$app" >> "$LOG"
    fi
done

# 3. ROUTE B: Root Home Dotfiles (goes to ~/.app_name)
ROOT_FILES=("tmux.conf" "vimrc" "zshrc")

for file in "${ROOT_FILES[@]}"; do
    if [[ -f "$TARGET_DIR/$file" ]]; then
        rm -f "$HOME/.$file"
        ln -s "$TARGET_DIR/$file" "$HOME/.$file"
        echo "Routed Root: ~/.$file -> Dotfiles/$file" >> "$LOG"
    fi
done

# 4. SOLVE THE CHICKEN-AND-EGG: Force systemd to notice the newly symlinked timer
echo "Reloading systemd user daemon..." >> "$LOG"
systemctl --user daemon-reload
systemctl --user enable --now dotfiles-backup.timer >> "$LOG" 2>&1

# 5. Lock it down
touch "$MARKER"
safe_notify "Welcome to GalihOS" "Rice applied & backup timer activated!" "normal"
